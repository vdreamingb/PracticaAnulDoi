<Page x:Class="Practica.Localitati"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica"
      mc:Ignorable="d" 
      Title="Localitati">

    <Grid>
        <Border ClipToBounds="True" BorderBrush="#FF767575" CornerRadius="15"  BorderThickness="1" Margin="0,134,0,0" Background="#30302e">
            <DataGrid x:Name="localitatiTable" d:ItemsSource="{d:SampleData ItemCount=5}" BorderThickness="0" HeadersVisibility="Column"  Background="Transparent" BorderBrush="{x:Null}" HorizontalGridLinesBrush="{x:Null}" VerticalGridLinesBrush="{x:Null}" Foreground="#fff" RowBackground="#FF343434">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="50" />
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="30 10"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
        </Border>
        <WrapPanel Margin="0,37,0,337">
            <Button Content="+ Adauga" Height="39" Width="180" Margin="10 0 10 0" Background="{x:Null}" Foreground="White"/>
            <Button Content="- Sterge" Height="39" Width="180" Margin="0" Background="{x:Null}" Foreground="White"/>
            <Button Content="Modifica" Height="39" Width="180" Margin="10 0" Background="{x:Null}" Foreground="White"/>
            <Button Content="Exporteaza" Height="39" Width="180" Margin="0 0 10 0" Background="{x:Null}" Foreground="White"/>
        </WrapPanel>

    </Grid>
</Page>
