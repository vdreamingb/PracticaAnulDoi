<Window x:Class="Practica.LogInWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica"
        mc:Ignorable="d"
        Title="LogInWindows" Height="405" Width="552">
    <Grid Background="#FF141414">
        <Label Content="Logare" HorizontalAlignment="Left" Margin="223,62,0,0" VerticalAlignment="Top" FontSize="28" Foreground="White"/>
        <Label Content="Nume de utilizator:" HorizontalAlignment="Left" Margin="84,132,0,0" VerticalAlignment="Top" Foreground="White"/>
        <TextBox x:Name="usernameTextBox" HorizontalAlignment="Center" Margin="0,163,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="384" Height="19"/>
        <Label Content="Parola:" HorizontalAlignment="Left" Margin="84,203,0,0" VerticalAlignment="Top" Background="{x:Null}" Foreground="White"/>
        <PasswordBox x:Name="passwordTextBox" HorizontalAlignment="Center" Margin="0,234,0,0" VerticalAlignment="Top" Width="384" Height="19"/>
        <Button Content="Logare" HorizontalAlignment="Center" Height="43" Margin="0,277,0,0" VerticalAlignment="Top" Width="384" Background="#FFF0F0F0" Click="Button_Click"/>
    </Grid>
</Window>
