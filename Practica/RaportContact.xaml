<Page x:Class="Practica.RaportContact"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RaportContact">

    <DataGrid CanUserAddRows="False" x:Name="dgContact" d:ItemsSource="{d:SampleData ItemCount=5}" BorderThickness="0" HeadersVisibility="Column"  Background="Transparent" BorderBrush="{x:Null}" HorizontalGridLinesBrush="{x:Null}" VerticalGridLinesBrush="{x:Null}" Foreground="#fff" RowBackground="#FF343434" SelectionChanged="dgContact_SelectionChanged" Margin="0 30">
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <Setter Property="Height" Value="50" />
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="30 10"/>
            </Style>
        </DataGrid.ColumnHeaderStyle>
    </DataGrid>
</Page>
