    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="Nume" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="Prenume" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="Adresa" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="Telefon" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="Email" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="NumeLoc" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="Tip" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="Judet" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="CodLoc" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="CodLoc" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Localitati" />
              <Join Type="INNER JOIN" ColumnOwner="Beneficiari">
                <On>
                  <From ColumnOwner="Localitati" ColumnName="CodLoc" />
                  <To ColumnOwner="Beneficiari" ColumnName="CodLoc" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Beneficiari.Nume
  ,Beneficiari.Prenume
  ,Beneficiari.Adresa
  ,Beneficiari.Telefon
  ,Beneficiari.Email
  ,Localitati.NumeLoc
  ,Localitati.Tip
  ,Localitati.Judet
  ,Beneficiari.CodLoc AS [Beneficiari CodLoc]
  ,Localitati.CodLoc AS [Localitati CodLoc]
FROM
  Localitati
  INNER JOIN Beneficiari
    ON Localitati.CodLoc = Beneficiari.CodLoc</CommandText>
      </Query>
