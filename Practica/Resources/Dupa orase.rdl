        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <SelectedColumns>
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="CodBen" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="NrBen" />
              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="Nume" />
