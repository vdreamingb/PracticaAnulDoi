              <ColumnExpression ColumnOwner="Beneficiari" ColumnName="CodLoc" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="CodLoc" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="NumeLoc" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="Tip" />
              <ColumnExpression ColumnOwner="Localitati" ColumnName="Judet" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="Localitati" />
              <Join Type="INNER JOIN" ColumnOwner="Beneficiari">
                <On>
                  <From ColumnOwner="Localitati" ColumnName="CodLoc" />
                  <To ColumnOwner="Beneficiari" ColumnName="CodLoc" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  Beneficiari.CodBen
  ,Beneficiari.NrBen
  ,Beneficiari.Nume
  ,Beneficiari.Prenume
  ,Beneficiari.Adresa
  ,Beneficiari.Telefon
  ,Beneficiari.Email
  ,Beneficiari.CodLoc AS [Beneficiari CodLoc]
  ,Localitati.CodLoc AS [Localitati CodLoc]
  ,Localitati.NumeLoc
  ,Localitati.Tip
  ,Localitati.Judet
FROM
  Localitati
  INNER JOIN Beneficiari
    ON Localitati.CodLoc = Beneficiari.CodLoc</CommandText>
      </Query>
