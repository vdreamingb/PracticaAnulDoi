  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=Home-PC\SQLEXPRESS;Initial Catalog=Beneficiari</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>9a27e481-2d18-4df0-9443-c6addc879f88</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
  b.CodBen,
  b.NrBen,
  b.Nume,
  b.Prenume,
  b.Adresa,
  b.Telefon,
  b.Email,
  b.CodLoc AS [Beneficiari CodLoc],
  l.CodLoc AS [Localitati CodLoc],
  l.NumeLoc,
  l.Tip,
  l.Judet
FROM Localitati l
INNER JOIN Beneficiari b ON l.CodLoc = b.CodLoc</CommandText>
      </Query>
      <Fields>
        <Field Name="CodBen">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>CodBen</DataField>
        </Field>
        <Field Name="NrBen">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>NrBen</DataField>
        </Field>
        <Field Name="Nume">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nume</DataField>
        </Field>
        <Field Name="Prenume">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Prenume</DataField>
        </Field>
        <Field Name="Adresa">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Adresa</DataField>
        </Field>
        <Field Name="Telefon">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Telefon</DataField>
        </Field>
        <Field Name="Email">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Email</DataField>
        </Field>
        <Field Name="Beneficiari_CodLoc">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Beneficiari CodLoc</DataField>
        </Field>
        <Field Name="Localitati_CodLoc">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Localitati CodLoc</DataField>
        </Field>
        <Field Name="NumeLoc">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>NumeLoc</DataField>
        </Field>
        <Field Name="Tip">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Tip</DataField>
        </Field>
        <Field Name="Judet">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Judet</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
