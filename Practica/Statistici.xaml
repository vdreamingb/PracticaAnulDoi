<Page xmlns:Shared="clr-namespace:Syncfusion.Windows.Shared;assembly=Syncfusion.Shared.WPF"  x:Class="Practica.Statistici"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica"
      xmlns:BoldReports="clr-namespace:BoldReports.UI.Xaml;assembly=BoldReports.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Statistici">
    <Grid>
        <TabControl SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="Beneficiari">
                <BoldReports:ReportViewer x:Name="ReportViewer1" />
            </TabItem>

            <TabItem Header="Dupa localitati">
                <BoldReports:ReportViewer x:Name="ReportViewer2" />
            </TabItem>

            <TabItem Header="Tip de localitate">
                <BoldReports:ReportViewer x:Name="ReportViewer3" />
            </TabItem>
        </TabControl>
    </Grid>
</Page>