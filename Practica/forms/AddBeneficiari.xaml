<Page x:Class="Practica.AddBeneficiari"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Practica"
      mc:Ignorable="d"
      Title="AddBeneficiari" Width="322" Height="565">

    <Grid>
        <Label Content="Numar Beneficiar" HorizontalAlignment="Left" Margin="27,29,0,0" VerticalAlignment="Top" Width="111" Foreground="White"/>
        <TextBox x:Name="nrBenTextBox" HorizontalAlignment="Center" Margin="0,55,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>
        <Label Content="Nume" HorizontalAlignment="Left" Margin="27,91,0,0" VerticalAlignment="Top" Width="85" Foreground="White"/>
        <TextBox x:Name="surnameTextBox" HorizontalAlignment="Center" Margin="0,117,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>
        <Label Content="Prenume" HorizontalAlignment="Left" Margin="27,154,0,0" VerticalAlignment="Top" Width="85" Foreground="White"/>
        <TextBox x:Name="nameTextBox" HorizontalAlignment="Center" Margin="0,180,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>
        <Label Content="Adresa" HorizontalAlignment="Left" Margin="27,228,0,0" VerticalAlignment="Top" Width="85" Foreground="White"/>
        <TextBox x:Name="addresBox" HorizontalAlignment="Center" Margin="0,254,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="27,298,0,0" VerticalAlignment="Top" Width="85" Foreground="White" RenderTransformOrigin="0.5,0.5">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <TextBox x:Name="emailTextBox" HorizontalAlignment="Center" Margin="0,324,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>
        <Label Content="Cod Locuitor" HorizontalAlignment="Left" Margin="27,368,0,0" VerticalAlignment="Top" Width="111" Foreground="White"/>
        <TextBox x:Name="codLocTextBox" HorizontalAlignment="Center" Margin="0,394,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>
        <Button Content="+ Adauga" HorizontalAlignment="Center" Margin="0,503,0,0" VerticalAlignment="Top" Height="35" Width="269" Click="Button_Click"/>
        <Label Content="Telefon" HorizontalAlignment="Left" Margin="29,435,0,0" VerticalAlignment="Top" Width="111" Foreground="White"/>
        <TextBox x:Name="phoneNumberTextBox" HorizontalAlignment="Center" Margin="0,461,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="270" Height="23"/>

    </Grid>
</Page>
