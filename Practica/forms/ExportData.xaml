<Window x:Class="Practica.ExportData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica"
        mc:Ignorable="d"
        Title="ExportData" Height="215" Width="398" Background="#FF141414">
    <Grid>
        <Label Content="In ce format doriti sa exportati datele" HorizontalAlignment="Left" Margin="52,40,0,0" VerticalAlignment="Top" Width="305" Background="{x:Null}" Foreground="White" FontSize="18"/>
        <Button Content="Excel" HorizontalAlignment="Left" Margin="52,100,0,0" VerticalAlignment="Top" Height="27" Width="133" Background="White" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Button Content="Word" HorizontalAlignment="Left" Margin="224,100,0,0" VerticalAlignment="Top" Height="27" Width="133" Background="#FFFAFAFA" BorderBrush="{x:Null}" Click="Button_Click_1"/>

    </Grid>
</Window>
